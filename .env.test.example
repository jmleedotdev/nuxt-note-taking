# Copy to .env.test.local for local tests; CI can supply DATABASE_URL directly.
# Use a disposable PostgreSQL cluster with CREATEDB permission, never production.
# These defaults match the local Compose service. Use a separate test cluster if needed.
# The harness creates/drops random notes_test_* databases, not this named database.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/notes
