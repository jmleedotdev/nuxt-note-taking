{
  "name": "nuxt-note-taking",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "tsx scripts/test-database.ts",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:http": "tsx scripts/test-database.ts exec vitest run --project http",
    "test:mail": "tsx scripts/test-database.ts exec vitest run --config vitest.mail.config.ts",
    "demo:provision": "tsx scripts/provision-demo.ts",
    "test:browser:demo": "APP_TEST_ORIGIN=http://127.0.0.1:3000 tsx scripts/test-database.ts exec playwright test --config playwright.demo.config.ts",
    "test:browser": "APP_TEST_ORIGIN=http://127.0.0.1:3000 tsx scripts/test-database.ts exec playwright test",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.2.1",
    "@nuxt/test-utils": "4.3.4",
    "@nuxt/ui": "4.12.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-bubble-menu": "^3.32.2",
    "@tiptap/extension-code": "^3.32.2",
    "@tiptap/extension-collaboration": "^3.32.2",
    "@tiptap/extension-drag-handle": "^3.32.2",
    "@tiptap/extension-drag-handle-vue-3": "^3.32.2",
    "@tiptap/extension-floating-menu": "^3.32.2",
    "@tiptap/extension-horizontal-rule": "^3.32.2",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-mention": "^3.32.2",
    "@tiptap/extension-node-range": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@tiptap/suggestion": "^3.32.2",
    "@tiptap/vue-3": "^3.32.2",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "nuxt": "^4.6.3",
    "postgres": "4.0.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.14"
  }
}
