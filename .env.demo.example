# Vercel Production ONLY. Enter private values in the dashboard, not git.
# Never expose credentials through NUXT_PUBLIC_* or public runtimeConfig.
APP_ENV=demo
APP_URL=https://your-project.vercel.app
# Runtime: Supabase Connect -> Transaction pooler (6543), with verified TLS.
# Copy the exact host and project username; URL-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Generate DIFFERENT private values with: openssl rand -hex 32
APP_AUTH_SECRET=
CRON_SECRET=
# Demo selects no-mail mode automatically. No mail variables required.
# Leave APP_TRUSTED_PROXY_IP unset pending actual Vercel ingress validation.
# VERCEL and VERCEL_ENV are platform supplied; do not spoof them locally.
# Provisioning passwords belong only in the operator shell, never runtime.
